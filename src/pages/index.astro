---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { apps } from '~/data/apps';
import { getPermalink } from '~/utils/permalinks';

// 真实 App 图标（与 /allApps/ 页面同源），填充 Our Apps 的圆形图标位
import logoChronicle from '~/assets/images/post/chronicle/chronicle_logo.png';
import logoMeowTalkie from '~/assets/images/post/meow-talkie/logo.png';
import logoAiTrans from '~/assets/images/aitrans_logo.png';
import logoAesthetic from '~/assets/images/post/aesthetic-calculator/logo-512.png';
import logoDeliseek from '~/assets/images/post/deliseek/deliseek_logo.png';
import logoFocusOne from '~/assets/images/post/focus-one/focus_one_logo.png';
import logoFlipTimer from '~/assets/images/post/flip-timer/flip-timer-logo-512.png';
import logoPhotoSwipe from '~/assets/images/post/photo-swipe-cleaner/photo-swipe-cleaner-logo-512.png';
import logoVocalTrans from '~/assets/images/travelappicon/vocaltrans_logo.png';

const appIcons = {
  chronicle: logoChronicle,
  meowtalkie: logoMeowTalkie,
  aitrans: logoAiTrans,
  'aesthetic-calculator': logoAesthetic,
  deliseek: logoDeliseek,
  'focus-one': logoFocusOne,
  'flip-timer': logoFlipTimer,
  'photo-swipe-cleaner': logoPhotoSwipe,
  vocaltrans: logoVocalTrans,
};

const metadata = {
  title: 'Winki | Small Apps for Everyday Life',
  description:
    'Explore Winki apps for journaling, focus, photo cleanup, calculation, cat sounds and travel. Find product details, download links and developer notes.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{ src: '~/assets/images/hero-image.png', alt: 'Winki Hero Image' }}
    imageHref={getPermalink('/allApps')}
    actions={[{ text: 'Explore the apps', href: '#apps', variant: 'primary' }]}
  >
    <Fragment slot="title">
      Small apps for <span class="text-accent dark:text-white">everyday life.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Plan your day, focus on one task, sort your photos or find a small tool for your next trip. Explore each product
      to check its features, platform and download options.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />

  <!-- Features Widget *************** -->

  <Features
    id="apps"
    tagline="Explore"
    title="Our Apps"
    subtitle="Choose a product, read its details and find the right download for your device."
    linkItems
    items={apps.map((app) => ({
      title: app.name,
      description: app.description,
      icon: appIcons[app.id],
      callToAction: { text: `Explore ${app.name}`, href: getPermalink(`/homes/${app.id}`) },
    }))}
  />

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Focus on one thing',
        description:
          "We make timing and reminders straightforward: Focus One's single‑task visual timer and Flip Timer's hands‑free switching help you find your rhythm for study, work and training.",
      },
      {
        title: 'Plan and record on one timeline',
        description:
          'Chronicle blends agenda, tasks and notes into a private personal timeline—local‑first, no nagging.',
      },
      {
        title: 'Photo cleanup without second‑guessing',
        description:
          'Photo Swipe Cleaner lets you keep or delete with simple swipes—safe deletions, no accidents, quick storage wins.',
      },
      {
        title: 'Useful, and beautiful',
        description:
          'Aesthetic Calculator delivers a clean calculation experience with playful themes; the core stays distraction‑free.',
      },
      {
        title: 'Closer to your pet',
        description: 'MeowTalkie uses a playful soundboard and interactions to help with training, recall and bonding.',
      },
      {
        title: 'Small, but serious',
        description: 'Small and focused features—less is more. Every iteration polishes the details.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">
      We make these apps for everyday small things: focus better, plan simply, clean up photos, and get closer to your
      pet.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Listen and iterate',
        description:
          'We refine interactions, motion flows and copy based on real feedback—so the tools feel more natural.',
      },
      {
        title: 'Unobtrusive experience',
        description: 'Simple flows and a clean interface reduce the learning curve—open and use.',
      },
      {
        title: 'Local‑first and privacy',
        description: 'What belongs on your device stays on your device; you control your data.',
      },
      {
        title: 'Lightweight yet reliable',
        description: 'Small footprint and steady performance; updates focus on stability and ease.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">
      We take every detail seriously—smoother steps, human copy, fewer taps. Each update is a small step toward easier
      use.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Getting started is simple"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Choose your need</span>',
        description:
          'On the homepage, pick the app for your need: focus timing, planning & journaling, photo cleanup, lightweight utility, or pet interaction.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Step 2: <span class="font-medium">Open the product page</span>',
        description: 'See core scenarios and screenshots—check that it fits your routine.',
        icon: 'tabler:photo',
      },
      {
        title: 'Step 3: <span class="font-medium">Download or join testing</span>',
        description: 'Find the App Store/Google Play or test entry on the product page; install and start.',
        icon: 'tabler:download',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts title="Find out more content in our Blog" information={`Explore product updates and notes.`} />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Choosing an app, downloading it and getting support."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Where can I download an app?',
        description:
          'Open its product page and follow the available App Store or Google Play link. Availability can vary by device and country.',
      },
      {
        title: 'Are all apps available on the same platforms?',
        description:
          'No. Each product page lists its own download options. Check the store listing for current device compatibility.',
      },
      {
        title: 'How do I check pricing?',
        description:
          'Check the store listing and the app’s purchase screen for current prices, optional purchases and any subscription terms.',
      },
      {
        title: 'How can I get support?',
        description:
          'Email winkiwiki@QQ.com with the app name, device, operating system and app version. Do not include private journal entries, photos or payment details.',
      },
      {
        title: 'Where can I read about the products?',
        description: `Visit the <a href="${getPermalink('/blog')}">blog</a> for developer stories and product updates, or <a href="${getPermalink('/about')}">learn about Winki</a>.`,
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <!-- CallToAction Widget *********** -->
</Layout>
