---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About Winki and Its Apps',
  ignoreTitleTemplate: true,
  description: 'Learn about Winki’s everyday apps, read first-hand developer notes and find product support.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero tagline="About Winki">
    <Fragment slot="title"> Small tools, built around everyday needs. </Fragment>

    <Fragment slot="subtitle">
      Winki brings together apps for journaling, focus, photos, calculation, cat sounds and travel. This website is
      maintained by the products’ developer.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <section class="max-w-3xl mx-auto px-6 pb-16 prose dark:prose-invert">
    <h2>Notes from the developer</h2>
    <p>
      Our blog includes first-hand accounts of building these apps, including design choices and technical limits. Posts
      attributed to Winki Team are published by Winki, not independent product reviews.
    </p>
    <p><a href={getPermalink('/blog')}>Read developer stories and product updates</a>.</p>
    <h2>Find the right app</h2>
    <p>
      Each product has its own features and platform availability.
      <a href={`${getPermalink('/')}#apps`}>Explore the app directory</a> and check the store listing before installing.
    </p>
    <h2>Feedback and support</h2>
    <p>
      Email <a href="mailto:winkiwiki@QQ.com">winkiwiki@QQ.com</a> with the product name and version. See the <a
        href={getPermalink('/contact')}>support page</a
      > for what to include.
    </p>
  </section>
</Layout>
