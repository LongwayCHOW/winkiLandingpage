---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Winki App Support',
  ignoreTitleTemplate: true,
  description:
    'Get help with a Winki app. Email the developer with your app version, device and a description of the issue.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'General support',
        description: 'Ask about a Winki app, its download options or a problem you encountered.',
      },
      {
        title: 'Purchases',
        description:
          'For purchase questions, include the app name and store. Never send card numbers, passwords or full payment credentials.',
      },
      {
        title: 'Technical support',
        description:
          'Include your device, operating system, app version and steps to reproduce the issue. Share screenshots only after removing private information.',
      },
      {
        title: 'Email',
        description: '<a href="mailto:winkiwiki@QQ.com" class="underline">winkiwiki@QQ.com</a>',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
