---
/**
 * Aesthetic Calculator 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：aesthetic calculator（塔尖）；cute calculator themes / calculator skins / designer calculator（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

// 本地 banner：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import aestheticCalculatorBanner from '~/assets/images/banner/aesthetic_calculator_banner-1024x502.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'Aesthetic Calculator',
  keywords: 'aesthetic calculator, cute calculator themes, calculator skins, designer calculator',
  valueProp: 'A designer calculator with cute themes, skins and custom colors — pro math, ad-free.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/aesthetic-calculator/id6748415125',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.aesthetic_calculator',
  url: getPermalink(Astro.url.pathname),
  banner: {
    src: aestheticCalculatorBanner.src,
    alt: 'Aesthetic Calculator — cute themes, skins and colors for a designer calculator',
  },
  iosAppStoreId: 'id6748415125',
  androidAppStoreId: 'wiki.winki.aesthetic_calculator',
};

/* 页面 SEO metadata：title 50-60 字符核心词靠前；description 含 CTA */
const metadata = {
  title: 'Aesthetic Calculator: Cute Themes & Skins',
  description:
    'Tired of boring calculators? Customize with aesthetic themes, cute skins and colors. Pro math, ad-free. Perfect for school and daily use. Download free today.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: aestheticCalculatorBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'What makes Aesthetic Calculator different?',
    description:
      'A designer calculator with aesthetic themes, custom colors and cute skins. Personalize every tap.',
  },
  {
    title: 'Is it free and ad-free?',
    description:
      'Yes. The core experience is 100% ad-free. Optional in-app purchases unlock extra themes.',
  },
  {
    title: 'Can I use it for school and college?',
    description:
      'Absolutely. Advanced calculations, a history log and a clear layout make it perfect for study and daily math.',
  },
  {
    title: 'How do themes and colors work?',
    description: 'Pick from hundreds of designs or create your own palette. Save and switch anytime.',
  },
  {
    title: 'Does it include specialized calculators?',
    description: 'It includes a handy tip calculator, with more utilities being added regularly.',
  },
  {
    title: 'Is it available on iPhone and Android?',
    description: 'Yes. iPhone and iPad are supported now; Android availability is planned.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={`${app.name}: ${app.keywords.split(',')[0]}`}
    description={app.valueProp}
    url={app.url}
    image={aestheticCalculatorBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: aestheticCalculatorBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
      style: 'cursor: pointer;',
      'data-aw-banner-open': '1',
      'data-aw-open-apple': app.appStoreDownloadLink,
      'data-aw-open-google': app.googlePlayDownloadLink,
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Aesthetic Calculator</span>: Cute Themes &amp; Skins
    </Fragment>

    <Fragment slot="subtitle">Designer calculator with colors, skins and pro math — ad-free</Fragment>

    <Fragment slot="content">
      Aesthetic Calculator turns a boring calculator into a beautiful homescreen piece — pick cute themes, skins and
      custom colors, while getting advanced math for school and daily use. Ad-free, and perfect for study.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Aesthetic Calculator on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Aesthetic Calculator on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="A Calculator That Feels Like Yours"
    subtitle="Designer themes, custom colors and pro math — beauty and function in one."
    columns={2}
    items={[
      {
        title: 'Hundreds of Themes & Skins',
        description:
          'From minimalist and retro to pink pastel — designer calculator themes crafted to inspire your homescreen.',
        icon: 'tabler:palette',
      },
      {
        title: 'Keyboard, Reimagined',
        description:
          'Unique button styles and layout inspired by Bauhaus grids, Swiss typography and Dieter Rams principles.',
        icon: 'tabler:keyboard',
      },
      {
        title: 'Custom Colors & Skins',
        description: 'Create your own palette and cute skins. Save and switch anytime to match your style.',
        icon: 'tabler:brush',
      },
      {
        title: 'Advanced Calculations',
        description:
          'Handle brackets, signed numbers and complex equations for coursework, work and everyday math.',
        icon: 'tabler:calculator',
      },
      {
        title: 'History Log',
        description: 'Review past calculations easily — a clear layout that keeps your work in view.',
        icon: 'tabler:history',
      },
      {
        title: '100% Ad-Free',
        description: 'No ads, no interruptions — a calm calculator that stays out of your way.',
        icon: 'tabler:ad-off',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：设计理念 + 学习/工具（恢复自原始内容）═══════════ -->
  <Content
    title="Design Heritage & Connection"
    items={[
      {
        title: 'Bauhaus Grids',
        description: 'Grid systems and clear hierarchy shape key spacing and layout, bringing order to the keyboard.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Swiss Typography',
        description:
          'Legible labels and numerals (including roman numerals) influenced by classic typographic practice.',
        icon: 'tabler:typography',
      },
      {
        title: 'Dieter Rams Principles',
        description:
          'Less, but better. A calculator designed for real use: accounting, physics, electrical and daily math.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'Mechanical Keyboard Culture',
        description: 'Key grouping and tactile rhythm that connect with designers, students and accountants alike.',
        icon: 'tabler:keyboard',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'Aesthetic Calculator Design Heritage Image',
    }}
  />

  <Content
    title="Built for School & Daily Math"
    isReversed
    items={[
      {
        title: 'Advanced Calculations',
        description: 'Handle brackets, signed numbers, and complex equations for coursework and work.',
        icon: 'tabler:function',
      },
      {
        title: 'Full History Log',
        description: 'Scroll, copy, or reuse past entries with one tap.',
        icon: 'tabler:history',
      },
      {
        title: 'Big, Clear Buttons',
        description: 'Clean layout designed for error-free input and fast results.',
        icon: 'tabler:square-rounded',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'Aesthetic Calculator for School Image',
    }}
  />

  <Content
    title="Utilities & Calculators"
    items={[
      {
        title: 'Core Utilities',
        description:
          'Fraction calculator, percentage calculator, tip calculator, time calculator, timers and hours calculator. Built for math practice and everyday use.',
        icon: 'tabler:tools',
      },
      {
        title: 'Financial Tools (coming soon)',
        description:
          'Planned additions include mortgage and auto loan tools, payment estimators and everyday finance helpers for personal planning.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Converters & Extras',
        description:
          'Roman numerals and more handy utilities will be updated regularly. Available on iPhone & iPad; Android support is planned.',
        icon: 'tabler:transform',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&auto=format&fit=crop&w=774&q=80',
      alt: 'Aesthetic Calculator Utilities Image',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download Aesthetic Calculator and make math beautiful."
    subtitle="Free and ad-free — cute themes, skins and pro math for school and daily use."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Aesthetic Calculator on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Aesthetic Calculator on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
