---
/**
 * Chronicle 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：journal calendar（塔尖）；planner / to-do / habit tracker（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

// 本地 banner 图片：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import chronicleBanner from '~/assets/images/banner/Chronicle_banner-1024x504.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'Chronicle',
  keywords: 'journal calendar, planner, to-do list, habit tracker',
  valueProp: 'Journal, planner, to-do list and habit tracker on one simple timeline.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/chronicle-journal-calendar/id6756258484',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.chronicle.chronicle',
  url: getPermalink(Astro.url.pathname),
  banner: {
    src: chronicleBanner,
    alt: 'Chronicle Journal Calendar — notes, tasks and memories on one timeline',
  },
  iosAppStoreId: 'id6756258484',
  androidAppStoreId: 'wiki.winki.chronicle.chronicle',
};

/* 页面 SEO metadata：title 50-60 字符核心词靠前；description 含 CTA */
const metadata = {
  title: 'Chronicle: Journal Calendar, Planner & Habit Tracker',
  description:
    'See your notes, tasks and memories on one timeline. An all-in-one journal calendar, planner and habit tracker. Download free today.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: chronicleBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'What is Chronicle?',
    description:
      'Chronicle is a journal calendar that blends a daily planner, diary, to-do list and habit tracker into one timeline.',
  },
  {
    title: 'Is my data private?',
    description:
      'Yes. Chronicle is local-first by default — your notes, tasks and memories stay on your device unless you opt into cloud backup later.',
  },
  {
    title: 'Is there a free version?',
    description:
      'Yes. Chronicle is free to get started with core features. Chronicle Pro unlocks unlimited entries, widgets and advanced customization.',
  },
  {
    title: 'What devices does Chronicle support?',
    description: 'Chronicle is available on iOS and Android. Your timeline syncs across devices with optional cloud backup.',
  },
  {
    title: 'Can I use Chronicle for planning and habits?',
    description:
      'Yes. Use the daily and weekly planner to organize your agenda and tasks, and the minimalist habit tracker to build routines.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={`${app.name}: ${app.keywords.split(',')[0]}`}
    description={app.valueProp}
    url={app.url}
    image={chronicleBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: chronicleBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
      style: 'cursor: pointer;',
      'data-aw-banner-open': '1',
      'data-aw-open-apple': app.appStoreDownloadLink,
      'data-aw-open-google': app.googlePlayDownloadLink,
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Chronicle</span>: Journal Calendar
    </Fragment>

    <Fragment slot="subtitle">Planner, To-Do &amp; Habit Tracker on one timeline</Fragment>

    <Fragment slot="content">
      Chronicle is a journal calendar that brings your notes, tasks, habits and memories together in a single,
      beautiful timeline — your daily planner, private diary, to-do list and habit tracker in one place.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Chronicle on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Chronicle on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="Your Entire Life, Beautifully Organized"
    subtitle="Calendar, journal, planner, to-do and habit tracking — combined on one simple timeline."
    columns={2}
    items={[
      {
        title: 'The Journal Calendar Timeline',
        description:
          'A seamless, scrollable timeline that is both your schedule and your story. Notes, tasks and diary entries find their place.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Effortless Quick Capture',
        description: 'Add a note, to-do or journal entry from one unified input. No friction, just flow.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Daily & Weekly Planner',
        description: 'Organize your agenda and tasks with clarity. Plan days and weeks to build routines that stick.',
        icon: 'tabler:calendar-week',
      },
      {
        title: 'Private Journal & Diary',
        description: 'A secure, local-first space for thoughts, photos and moods. Your data is yours by default.',
        icon: 'tabler:notebook',
      },
      {
        title: 'Simple To-Do List',
        description: 'Check off goals with a satisfying tap. A distraction-free task list that keeps you moving.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Minimalist Habit Tracker',
        description: 'Build good routines without the pressure of complex streak systems.',
        icon: 'tabler:target',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：时间线体验（恢复自原始内容）═══════════ -->
  <Content
    title="Your Life on a Timeline"
    isReversed
    items={[
      {
        title: 'Smart Timeline',
        description: 'See agenda, tasks, notes and memories in chronological order — your schedule and story together.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Quick Capture',
        description: 'Instantly add a note, task or diary entry from a single button — perfect for “lazy” speed.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Local-First & Private',
        description:
          'Your data stays on device by default. Private journaling for thoughts, photos, moods and memories.',
        icon: 'tabler:lock',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'Chronicle Timeline Image',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download Chronicle today and start building the story of your life."
    subtitle="Free to get started — your journal calendar, planner and habit tracker on one timeline."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Chronicle on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Chronicle on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
