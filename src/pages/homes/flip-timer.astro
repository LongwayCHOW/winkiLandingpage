---
/**
 * Flip Timer 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：flip timer（塔尖）；hands-free countdown / interval timer / workout timer（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

// 本地 banner：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import flipTimerBanner from '~/assets/images/banner/flip_timer_banner-1024x501.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'Flip Timer',
  keywords: 'flip timer, hands-free countdown, interval timer, workout timer',
  valueProp: 'A hands-free countdown timer you control by flipping your phone — for gym, study, work and kitchen.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/flip-timer-gym-study-work/id6752959227',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.flip_timer',
  url: getPermalink(Astro.url.pathname),
  banner: {
    src: flipTimerBanner.src,
    alt: 'Flip Timer — hands-free countdown clock for gym, study and work',
  },
  iosAppStoreId: 'id6752959227',
  androidAppStoreId: 'wiki.winki.flip_timer',
};

/* 页面 SEO metadata：title 50-60 字符核心词靠前；description 含 CTA */
const metadata = {
  title: 'Flip Timer: Hands-Free Countdown for Gym, Study & Work',
  description:
    'Set any timer in a second — flip your phone for a 1, 5, 10, 15 or 30 minute countdown. The fastest hands-free timer for gym, study, work and kitchen. Download free.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: flipTimerBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'How do flip gestures work?',
    description:
      'Flip the phone to start a preset timer. Lay it flat to pause; shake to reset. Designed for hands-free control during workouts, study or kitchen prep.',
  },
  {
    title: 'Is it really hands-free?',
    description:
      'Yes. Motion sensors let you operate the countdown clock without touching the screen — perfect for sweaty hands or flour-covered fingers.',
  },
  {
    title: 'Does it support HIIT, Tabata and WOD?',
    description:
      'Yes. It is built as an interval timer and WOD clock companion. Switch sets and rests fast and keep focus on movement.',
  },
  {
    title: 'Can I use it for Pomodoro study and work?',
    description: 'Absolutely. Preset durations make it a simple pomodoro timer for focused work and study routines.',
  },
  {
    title: 'Does it show seconds and support a stopwatch?',
    description:
      'Yes. You get a large clock with seconds and a simple stopwatch alongside countdown — easy to see from a distance.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={`${app.name}: ${app.keywords.split(',')[0]}`}
    description={app.valueProp}
    url={app.url}
    image={flipTimerBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: flipTimerBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
      style: 'cursor: pointer;',
      'data-aw-banner-open': '1',
      'data-aw-open-apple': app.appStoreDownloadLink,
      'data-aw-open-google': app.googlePlayDownloadLink,
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Flip Timer</span>: Hands-Free Countdown
    </Fragment>

    <Fragment slot="subtitle">Gym, Study &amp; Work — flip to start, no screen touching</Fragment>

    <Fragment slot="content">
      Flip Timer is a hands-free countdown clock you operate without touching the screen. Flip your phone for a 10
      minute timer, a 30 minute timer for deep work, or a 1 minute timer for a plank — perfect for workouts, study and
      kitchen prep.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Flip Timer on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Flip Timer on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="A Timer That Moves With You"
    subtitle="Gesture control for real life — flip to start, lay flat to pause, shake to reset."
    columns={2}
    items={[
      {
        title: 'Gesture Control',
        description:
          'Flip your phone to one of its four sides to start a preset countdown — a 5 minute timer for meditation or a 45 minute timer for a full workout.',
        icon: 'tabler:arrows-move',
      },
      {
        title: 'Intuitive & Fast',
        description:
          'Lay your phone flat to pause; shake to reset. The fastest way to manage time during gym sessions, study blocks or kitchen prep.',
        icon: 'tabler:player-pause',
      },
      {
        title: 'Interval Timer for HIIT & Tabata',
        description:
          'Switch between high-intensity and rest without touching your screen. A reliable interval timer and WOD clock for any exercise routine.',
        icon: 'tabler:flame',
      },
      {
        title: 'Pomodoro for Study & Work',
        description:
          'Use preset timers for focused work or study sessions. A dependable pomodoro application for students and professionals.',
        icon: 'tabler:alarm',
      },
      {
        title: 'Kitchen Companion',
        description:
          'The ideal kitchen timer when your hands are covered in flour — a simple egg timer for boiling eggs or managing multiple pots.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Large, Clear Display',
        description:
          'A big, easy-to-read display with a visual progress bar and seconds — glance from across the room and stay in flow.',
        icon: 'tabler:gauge',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：功能/场景（恢复自原始内容，已剔除蹭品牌词）═══════════ -->
  <Content
    title="The Perfect Workout & HIIT Timer"
    isReversed
    items={[
      {
        title: 'HIIT & Tabata',
        description:
          'Switch between high-intensity and rest without touching your screen. Our interval timer keeps up with your pace.',
        icon: 'tabler:flame',
      },
      {
        title: 'CrossFit & WOD Clock',
        description: 'Time your Workout of the Day reliably. Focus on form, not your phone — hands-free WOD timing.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Any Exercise Routine',
        description:
          'From yoga stretches to circuit training, a versatile workout timer for the gym — rest 30 seconds or push a tough 2 minute set.',
        icon: 'tabler:run',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'Flip Timer Workout Image',
    }}
  />

  <Content
    title="More Than Just a Fitness Timer"
    isAfterContent
    items={[
      {
        title: 'Kitchen Companion',
        description:
          'The ideal kitchen timer when your hands are covered in flour. A simple egg timer for boiling eggs or managing multiple pots.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Pomodoro for Study & Work',
        description:
          'Use preset timers for focused work or study sessions. A reliable pomodoro application for students and professionals.',
        icon: 'tabler:alarm',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Flip Timer Kitchen & Productivity Image',
    }}
  />

  <Content
    title="Timers & Presets"
    items={[
      {
        title: '1, 5, 10, 15, 30 Minutes',
        description:
          'Start the perfect 1 minute timer, 5 minute timer, 10 minute timer, 15 minute timer or 30 minute timer with a flip — the fastest hands-free countdown.',
        icon: 'tabler:clock',
      },
      {
        title: '20, 45 Minutes & More',
        description:
          'Time blocking for deep work or long workouts — set a timer for 20 minutes or 45 minutes in one motion.',
        icon: 'tabler:clock',
      },
      {
        title: '30 Second & 2 Minute',
        description:
          'Micro-rests and short sets made easy. A versatile stopwatch and countdown app for gym, study and work routines.',
        icon: 'tabler:hourglass',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1506784983877-45594efa4cbe?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Flip Timer Presets Image',
    }}
  />

  <Content
    title="Clock & Countdown Modes"
    items={[
      {
        title: 'Stopwatch',
        description:
          'Works as a simple stopwatch alongside countdown. Stop stopwatch instantly by laying the phone flat — fast and intuitive.',
        icon: 'tabler:hourglass',
      },
      {
        title: 'Countdown Clock',
        description:
          'A reliable countdown timer for circuits, classroom, or any time-boxed routine.',
        icon: 'tabler:alarm',
      },
      {
        title: 'Alarm-Style Sessions',
        description:
          'Need an alarm set for 30 minutes? Just flip to the 30 minute preset — clear sound cues, clear finish.',
        icon: 'tabler:bell',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Clock Modes Image',
    }}
  />

  <Content
    title="Our Commitment"
    items={[
      {
        title: 'Free & Ad-Free',
        description:
          'The full hands-free flipping experience is available to everyone at no charge and contains no ads.',
        icon: 'tabler:ad-off',
      },
      {
        title: 'Built for Daily Life',
        description: 'Our mission is to build the fastest, most intuitive timer for gym, kitchen, study and work.',
        icon: 'tabler:target',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1560269507-0672f247de96?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Flip Timer Commitment Image',
    }}
  />

  <Content
    title="Policy & Support"
    isAfterContent
    items={[
      {
        title: 'In-App Purchases & Future Subscriptions',
        description:
          'Support development via one-time feature packs. We may introduce a simple, fair subscription to unlock premium features in the future.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Pricing',
        description:
          'Feature packs range from $2.99 to $5.99. Final prices follow real-time App Store pricing in your region.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Payment',
        description: 'After purchase confirmation, payment is charged to your iTunes Account.',
        icon: 'tabler:credit-card',
      },
      {
        title: 'Subscription Management',
        description:
          'When subscriptions become available, manage them in your Apple ID Account Settings at least 24 hours before period end.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Renewal Rules',
        description: "Subscriptions auto-renew unless canceled. We strictly follow Apple's App Store policies.",
        icon: 'tabler:refresh',
      },
      {
        title: 'Privacy Policy',
        description:
          '<a class="underline" href="https://z8o7hs56u3.feishu.cn/docx/MTPbdl1rToAwVLx80FPcyN8dnQg" target="_blank" rel="noopener">View our Privacy Policy</a>.',
        icon: 'tabler:shield',
      },
      {
        title: 'User & Member Subscription Agreement',
        description:
          '<a class="underline" href="https://z8o7hs56u3.feishu.cn/docx/IRW7dLWX2oa4nZxnwlQcurNFn7b" target="_blank" rel="noopener">Read the Subscription Agreement</a>.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Support',
        description: 'Questions or ideas? Email winkiwiki@QQ.com. We would love to hear from you.',
        icon: 'tabler:mail',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Flip Timer Policy Image',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download Flip Timer and change the way you time, forever."
    subtitle="Hands-free multi-timer for gym, study and work. Flip to start."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Flip Timer on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Flip Timer on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
