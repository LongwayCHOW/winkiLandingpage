---
/**
 * Photo Swipe Cleaner 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：photo cleaner（塔尖）；clean photo gallery / delete duplicate photos / free up storage（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getCanonical } from '~/utils/permalinks';

// 本地 banner：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import photoSwipeCleanerBanner from '~/assets/images/banner/photo_swipe_cleaner_banner-1024x500.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'Photo Swipe Cleaner',
  keywords: 'photo cleaner, clean photo gallery, delete duplicate photos, free up storage',
  valueProp: 'Review your photo gallery manually with swipe controls and choose which pictures to keep or delete.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/photo-swipe-cleaner-clean-up/id6752958088',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.photo_swipe_cleaner',
  url: String(getCanonical(Astro.url.pathname)),
  banner: {
    src: photoSwipeCleanerBanner.src,
    alt: 'Photo Swipe Cleaner — swipe to sort and clean up your photo gallery',
  },
  iosAppStoreId: 'id6752958088',
  androidAppStoreId: 'wiki.winki.photo_swipe_cleaner',
};

/* Metadata should describe the actual app, not a keyword list. */
const metadata = {
  title: 'Photo Swipe Cleaner: Clean Up Your Gallery',
  description:
    'Review photos one at a time with swipe controls. Choose what to keep or delete, compare similar shots yourself and make room in your gallery.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: photoSwipeCleanerBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'What is Photo Swipe Cleaner?',
    description:
      'A mindful gallery cleaner that helps you declutter photos with a clear swipe interface and a safety net for mistakes.',
  },
  {
    title: 'Is deleting safe?',
    description:
      'Review your selections before confirming deletion and keep a separate backup of important photos. Recovery depends on the app version and your device’s photo service; permanent deletion may not be reversible.',
  },
  {
    title: 'Can it help with duplicate photos?',
    description:
      'Yes. A large preview design makes it easy to spot and delete duplicate and similar-looking images yourself.',
  },
  {
    title: 'How do swipe controls work?',
    description:
      'Swipe left to delete, swipe right to keep, and swipe up to view details. Simple gestures to clean your camera roll and photo gallery.',
  },
  {
    title: 'Does it support iPhone and Android?',
    description:
      'Yes. It works with the Photos app and gallery on both platforms, helping you free up storage on your phone.',
  },
  {
    title: 'Is the core experience free?',
    description:
      'Yes. Core features are free and ad-free. Future premium options may be offered via in-app purchases or subscription.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={app.name}
    description={app.valueProp}
    url={app.url}
    image={photoSwipeCleanerBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: photoSwipeCleanerBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Photo Swipe Cleaner</span>: Clean Up Your Gallery
    </Fragment>

    <Fragment slot="subtitle">Review your gallery manually and keep the photos that matter</Fragment>

    <Fragment slot="content">
      Torn between “Storage Full” and the fear of deleting memories? Photo Swipe Cleaner helps you clean your photo
      gallery with confidence — swipe to sort, keep the cherished moments, and remove the rest.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Photo Swipe Cleaner on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Photo Swipe Cleaner on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="A Mindful Way to Clean Your Photo Gallery"
    subtitle="Swipe to sort photos with confidence — speed and security in one app."
    columns={2}
    items={[
      {
        title: 'The Mindful Swipe',
        description:
          'Swipe left to delete, swipe right to keep. A calm, fast way to declutter your camera roll without decision fatigue.',
        icon: 'tabler:arrows-left-right',
      },
      {
        title: 'Review Before Deleting',
        description:
          'Check your selections and keep a backup before deleting important pictures. No cleanup tool can guarantee recovery after permanent deletion.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Spot & Delete Duplicates',
        description:
          'Compare similar-looking photos yourself in the preview. This is manual review, not an automatic duplicate scan.',
        icon: 'tabler:copy-off',
      },
      {
        title: 'Free Up Storage Fast',
        description:
          'Remove unwanted photos from your gallery. Space recovered depends on the files you delete and the photo service’s retention settings.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Rediscover Joy, Not Just Space',
        description: 'Reconnect with your memories as you sort — keep what matters, remove the rest.',
        icon: 'tabler:heart',
      },
      {
        title: '100% Ad-Free',
        description: 'A calm, focused experience with no ads or interruptions while you sort.',
        icon: 'tabler:ad-off',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：人群 + 工具（恢复自原始内容）═══════════ -->
  <Content
    title="Perfect For"
    isReversed
    items={[
      {
        title: 'Feeling overwhelmed by your gallery',
        description: 'Calmly sort photos without pressure. Keep what matters, remove the rest.',
        icon: 'tabler:photo',
      },
      {
        title: 'Organizing albums, but not sure where to start',
        description: 'A simple, guided flow to organize and declutter albums with confidence.',
        icon: 'tabler:folders',
      },
      {
        title: 'Parents who need more storage',
        description: 'Save every precious moment while freeing up space for new ones.',
        icon: 'tabler:users',
      },
      {
        title: 'Afraid to lose important pictures',
        description:
          'Back up important pictures and review your selections. Do not rely on an undo action as a substitute for a backup.',
        icon: 'tabler:alert-circle',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'Photo Swipe Cleaner Audience Image',
    }}
  />

  <Content
    title="Tools & Optimizations"
    items={[
      {
        title: 'Review Photos to Free Up Storage',
        description:
          'Choose unwanted photos for deletion. Photo Swipe Cleaner is a gallery review tool, not a system cache cleaner or a general phone optimizer.',
        icon: 'tabler:database',
      },
      {
        title: 'Duplicate & Similar Photos',
        description:
          'Inspect duplicate and similar-looking pictures yourself, then decide which to keep. Automatic detection is not promised.',
        icon: 'tabler:copy',
      },
      {
        title: 'Camera Roll Sorter',
        description:
          'Clean the camera roll and organize albums. A smart picture sorter for gallery cleanup — swipe left to delete, swipe right to keep, swipe up to view details.',
        icon: 'tabler:sort-descending',
      },
      {
        title: 'Understand Deletion and Recovery',
        description:
          'Check the confirmation screen and your device’s Recently Deleted or trash options. Cloud photo services can sync deletions to other devices. Permanent deletion may be irreversible.',
        icon: 'tabler:arrow-back-up',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Photo Swipe Cleaner Tools & Optimizations Image',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download Photo Swipe Cleaner and clean your gallery with confidence."
    subtitle="Review photos, compare similar shots yourself and check your selections before deleting."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Photo Swipe Cleaner on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Photo Swipe Cleaner on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
