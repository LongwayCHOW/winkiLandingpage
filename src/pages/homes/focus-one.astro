---
/**
 * Focus One 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：focus timer（塔尖）；ADHD focus / pomodoro / monotasking（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getCanonical } from '~/utils/permalinks';

// 本地 banner：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import focusOneBanner from '~/assets/images/banner/focus_one_banner-1024x500.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'Focus One',
  keywords: 'focus timer, ADHD focus, pomodoro timer, monotasking',
  valueProp: 'A minimalist visual focus timer for ADHD and deep work. Do one thing at a time with Pomodoro.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/focus-one-adhd-focus-timer/id6748545171',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.focus_one',
  url: String(getCanonical(Astro.url.pathname)),
  banner: {
    src: focusOneBanner.src,
    alt: 'Focus One — ADHD focus timer and Pomodoro for deep work',
  },
  iosAppStoreId: 'id6748545171',
  androidAppStoreId: 'wiki.winki.focus_one',
};

/* Metadata should describe the actual app, not a keyword list. */
const metadata = {
  title: 'Focus One: Visual Focus Timer for One Task',
  description:
    'Beat procrastination with a visual focus timer built for monotasking. Study, work and ADHD-friendly Pomodoro sessions. Download free today.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: focusOneBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'What is Focus One?',
    description:
      'A minimalist ADHD-friendly focus timer that helps you do one task at a time using visual anchors and the Pomodoro method.',
  },
  {
    title: 'Is Focus One a treatment for ADHD?',
    description:
      'No. Focus One is a productivity timer, not a diagnostic or treatment tool. Its single-task design may suit your preferences, but it does not promise clinical outcomes or replace professional care.',
  },
  {
    title: 'Is Focus One free?',
    description:
      'Core features are free and ad-free. Pro unlocks advanced functions via in-app purchases or a future subscription.',
  },
  {
    title: 'Can I use it for study and work?',
    description:
      'Yes. It is great for students, writers, developers and anyone building routines with Pomodoro and time blocking.',
  },
  {
    title: 'Does it include a Pomodoro timer?',
    description:
      'Yes. Break work or study into manageable intervals with Pomodoro presets, plus quick timers for 1, 3, 15, 20 and 30 minutes.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={app.name}
    description={app.valueProp}
    url={app.url}
    image={focusOneBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: focusOneBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Focus One</span>: ADHD Focus Timer
    </Fragment>

    <Fragment slot="subtitle">A Pomodoro and visual focus timer for deep work</Fragment>

    <Fragment slot="content">
      Focus One is a visual focus timer built on monotasking. It channels all your energy into one important task with a
      calm GIF anchor and Pomodoro intervals — the perfect study buddy and productivity tool for your daily routine.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Focus One on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Focus One on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="Your Personal Focus Companion"
    subtitle="Built on monotasking — channel all your energy into one important task."
    columns={2}
    items={[
      {
        title: 'One Task, Zero Distractions',
        description:
          'The core of our focus system. Concentrate on a single item to eliminate mental clutter, reduce anxiety and boost productivity.',
        icon: 'tabler:target',
      },
      {
        title: 'Visual Focus Anchor',
        description:
          'Set a beautiful, calming GIF as your session background — a gentle looping visual that acts as a powerful focus timer for serene study time.',
        icon: 'tabler:photo',
      },
      {
        title: 'Pomodoro Technique',
        description:
          'Break work or study into manageable intervals. Perfect for time blocking and building a reliable routine for students and professionals.',
        icon: 'tabler:alarm',
      },
      {
        title: 'Quick Timer Presets',
        description:
          'Start a 15, 20 or 30 minute focus block with one tap, or grab a quick 3-minute and 1-minute countdown for micro-tasks.',
        icon: 'tabler:clock',
      },
      {
        title: 'ADHD-Friendly Design',
        description:
          'A single-task approach that reduces cognitive load and decision fatigue — fewer choices, one clear goal, more calm.',
        icon: 'tabler:brain',
      },
      {
        title: '100% Ad-Free',
        description: 'A calm, minimalist interface with no ads or distractions — just you and your focus session.',
        icon: 'tabler:ad-off',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：目标人群 + 预设（恢复自原始内容，已清理堆砌句）═══════════ -->
  <Content
    title="Who Is Focus One For?"
    isReversed
    items={[
      {
        title: 'Students',
        description: 'Ace your exams with a dedicated study timer and calm visual focus.',
        icon: 'tabler:notebook',
      },
      {
        title: 'Professionals, writers & developers',
        description: 'Practice deep work with simple time blocking and a non-overwhelming interface.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'ADHD & neurodiversity',
        description:
          'A single-task interface for people who prefer fewer choices. This is a productivity tool, not an ADHD treatment.',
        icon: 'tabler:brain',
      },
      {
        title: 'Digital detox & wellbeing',
        description: 'Reduce screen time and reclaim presence with a minimalist, visual timer.',
        icon: 'tabler:device-mobile-off',
      },
      {
        title: 'Beat procrastination',
        description: 'Build a productive morning routine and start doing one thing well.',
        icon: 'tabler:coffee',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'Focus One Audience Image',
    }}
  />

  <Content
    title="A Single-Task Focus Routine"
    items={[
      {
        title: 'Choose One Task',
        description:
          'Pick a concrete next action before starting. A small, clear task is easier to return to than a long list of competing priorities.',
        icon: 'tabler:clock',
      },
      {
        title: 'Choose a Session Length',
        description:
          'Choose a manageable duration in the app. Start shorter when getting started is the difficult part, rather than treating one preset as the right answer for everyone.',
        icon: 'tabler:clock',
      },
      {
        title: 'Use the Visual Anchor',
        description:
          'Longer single-task sessions for writers, developers and students. A minimalist visual timer keeps you present and productive.',
        icon: 'tabler:clock',
      },
      {
        title: 'Start Small',
        description:
          'Use a short countdown for a small action, such as opening a document or clearing your desk. A timer is an aid, not a neurological reset.',
        icon: 'tabler:alarm',
      },
      {
        title: 'Take a Break and Reassess',
        description:
          'After a session, pause and decide whether to continue the same task or choose another. Adjust the routine to your work and energy.',
        icon: 'tabler:alarm',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1506784983877-45594efa4cbe?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Focus One Timer Presets Image',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download Focus One today and do one thing well."
    subtitle="Free core features. Visual timer and Pomodoro, built for ADHD and deep work."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download Focus One on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get Focus One on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
