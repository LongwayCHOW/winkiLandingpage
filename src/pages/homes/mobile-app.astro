---
/**
 * ══════════════════════════════════════════════════════════════════════
 * App 落地页模板 — 极简 SEO 最佳实践（ZAC《SEO实战密码》+ SEO Writing）
 * ══════════════════════════════════════════════════════════════════════
 *
 * 复制本文件为 src/pages/homes/<your-app>.astro，然后只改两处：
 *   1. 「APP CONFIG」段：app 名称、核心关键词、下载链接
 *   2. 各 widget 的文案（用你的真实内容替换）
 *
 * 结构（自上而下，服务于"下载"转化目标）：
 *   Hero      → H1 含核心词 + 价值主张 + 首段含核心词 + 下载按钮
 *   Features  → 3-5 个功能，每个功能名自然包含功能词
 *   FAQ       → 5-8 个真实用户问题（同时生成 FAQPage schema）
 *   CallToAction → 最终下载 CTA
 *
 * SEO 要点已内置：
 *   - Title 50-60 字符，核心词靠前，吸引点击（不要中文冒号）
 *   - Description 150-160 字符，含核心词 + CTA
 *   - JSON-LD：SoftwareApplication + FAQPage（<AppSchema />）
 *   - 图片 ALT 描述性、含关键词
 *   - 内链锚文字描述性（勿用 "click here"）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
/* 复制模板时只改这一段的变量与文案                                  */
const app = {
  // 品牌名（出现在 H1 / CTA）
  name: 'Your App Name',
  // 核心关键词（2-4 个，来自关键词集群塔尖/塔身）
  keywords: 'journal calendar, planner, habit tracker',
  // 一句话价值主张（用户为什么下载）
  valueProp: 'Replace with one clear sentence: what problem does this app solve?',
  // 支持平台
  platforms: ['iOS', 'Android'],
  // 下载链接（用真实商店链接替换）
  appStoreDownloadLink: 'https://apps.apple.com/', // TODO: 替换
  googlePlayDownloadLink: 'https://play.google.com/', // TODO: 替换
  // 落地页 URL（自动跟随当前路径，复制模板后无需改动）
  url: getPermalink(Astro.url.pathname),
  // 主图（本地图片或 Unsplash）
  banner: {
    src: 'https://images.unsplash.com/photo-1535303311164-664fc9ec6532?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
    alt: 'Your App Name — app preview',
  },
  // iOS App Store ID（如 id6756258484）；没有留空
  iosAppStoreId: '',
  // Android 包名（如 wiki.winki.chronicle.chronicle）；没有留空
  androidAppStoreId: '',
};

/* 页面 SEO metadata */
const metadata = {
  // 50-60 字符：品牌名 + 核心词，靠前放，吸引点击
  title: 'Your App Name: Core Keyword Phrase for Users',
  // 150-160 字符：含核心词 + CTA
  description:
    'Your App Name helps you <core outcome>. Download free on the App Store and Google Play today.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: app.banner.src }],
  },
};

/* FAQ 数据：既是页面内容，也是 FAQPage schema 素材（真实问题，勿堆砌关键词） */
const faqItems = [
  {
    title: `What does ${app.name} do?`,
    description:
      'Replace with a plain-language answer: the core problem this app solves and how.',
  },
  {
    title: 'Is it available on my device?',
    description: `Describe supported platforms (${app.platforms.join(', ')}), requirements, and free/paid status.`,
  },
  {
    title: 'Is my data private?',
    description: 'Explain privacy stance, local-first or cloud, and link to the Privacy Policy.',
  },
  {
    title: 'How do I get started?',
    description: 'Give the first 1-2 steps a new user takes after downloading.',
  },
  {
    title: 'How can I get support?',
    description: 'Provide the support contact and expected response time.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={`${app.name}: ${app.keywords.split(',')[0]}`}
    description={app.valueProp}
    url={app.url}
    image={app.banner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{ src: app.banner.src, alt: app.banner.alt }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">{app.name}</span>: {app.keywords.split(',')[0]}
    </Fragment>

    <Fragment slot="subtitle">{app.valueProp}</Fragment>

    <Fragment slot="content">
      {app.name} is a {app.keywords}. Describe in one or two sentences, in the first ~100 words
      containing your core keyword, why users should download it.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download {app.name} on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get {app.name} on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title={`Why users choose ${app.name}`}
    subtitle="Replace with 3-5 core features. Each feature title should naturally contain a feature keyword."
    columns={2}
    items={[
      {
        title: 'Feature one (contains keyword)',
        description: 'One sentence: what it does and the benefit.',
        icon: 'tabler:star',
      },
      {
        title: 'Feature two (contains keyword)',
        description: 'One sentence: what it does and the benefit.',
        icon: 'tabler:star',
      },
      {
        title: 'Feature three (contains keyword)',
        description: 'One sentence: what it does and the benefit.',
        icon: 'tabler:star',
      },
      {
        title: 'Feature four (contains keyword)',
        description: 'One sentence: what it does and the benefit.',
        icon: 'tabler:star',
      },
    ]}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title={`Download ${app.name} today.`}
    subtitle="One final reason to download, including your core keyword."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download {app.name} on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get {app.name} on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
