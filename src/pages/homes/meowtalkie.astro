---
/**
 * MeowTalkie 落地页 — 基于 mobile-app.astro 模板（极简 SEO 最佳实践）
 * 核心词：talk to cat（塔尖）；cat sounds / cat communicator / cat training（功能词）
 */
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import AppSchema from '~/components/common/AppSchema.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

// 本地 banner：import 后取 .src 得到构建后的真实 URL（schema 需要可访问的绝对地址）
import meowTalkieBanner from '~/assets/images/banner/meow_talkie_banner-1024x500.png';

/* ─────────────────────────── APP CONFIG ─────────────────────────── */
const app = {
  name: 'MeowTalkie',
  keywords: 'talk to cat, cat sounds, cat communicator, cat training',
  valueProp: 'A playful soundboard of meows and calls to talk to your cat — for fun, training and bonding.',
  platforms: ['iOS', 'Android'],
  appStoreDownloadLink: 'https://apps.apple.com/us/app/meowtalkie-talk-to-your-cat/id6752669946',
  googlePlayDownloadLink: 'https://play.google.com/store/apps/details?id=wiki.winki.meow_talkie',
  url: getPermalink(Astro.url.pathname),
  banner: {
    src: meowTalkieBanner.src,
    alt: 'MeowTalkie — funny cat sounds and meows to talk to your cat',
  },
  iosAppStoreId: 'id6752669946',
  androidAppStoreId: 'wiki.winki.meow_talkie',
};

/* 页面 SEO metadata：title 50-60 字符核心词靠前；description 含 CTA */
const metadata = {
  title: 'MeowTalkie: Talk to Your Cat with Funny Sounds',
  description:
    'Call, train or chat with your cat using playful meows and sounds. A fun cat communicator app for bonding. Download free on the App Store and Google Play.',
  canonical: app.url,
  openGraph: {
    type: 'website',
    url: app.url,
    images: [{ url: meowTalkieBanner as unknown as string }],
  },
};

/* FAQ：真实用户会问的问题（也是 FAQPage schema 素材） */
const faqItems = [
  {
    title: 'What does MeowTalkie do?',
    description:
      'MeowTalkie is a cat communicator app that lets you talk to your cat using a soundboard of specially designed meows and calls — perfect for playtime, training and bonding.',
  },
  {
    title: 'Is MeowTalkie easy to use?',
    description:
      'Yes. A clean and intuitive interface makes it easy to send clear signals — call your cat for dinner, start playtime or simply get their attention.',
  },
  {
    title: 'Is MeowTalkie ad-free?',
    description: 'Yes. It offers a completely ad-free experience so you can focus on the fun, not the ads.',
  },
  {
    title: 'Does MeowTalkie work for all cats?',
    description: 'Yes. It works for kittens, adult cats and even testing on your friends’ pets.',
  },
  {
    title: 'Are there in-app purchases?',
    description:
      'Yes. In-app purchases unlock exclusive premium sound packs, priced from $0.99 to $5.99.',
  },
  {
    title: 'Is this a real cat translator?',
    description:
      'MeowTalkie is a playful cat communicator and soundboard — not a scientific translation service. It helps you send clear signals and read your cat’s reactions, for fun.',
  },
  {
    title: 'How can I get support?',
    description: 'Email winkiwiki@QQ.com with your app name, platform and version for faster help.',
  },
];
---

<Layout metadata={metadata}>
  <AppSchema
    name={`${app.name}: ${app.keywords.split(',')[0]}`}
    description={app.valueProp}
    url={app.url}
    image={meowTalkieBanner.src}
    operatingSystems={app.platforms}
    iosAppStoreId={app.iosAppStoreId}
    androidAppStoreId={app.androidAppStoreId}
    faqItems={faqItems.map((f) => ({ q: f.title, a: f.description }))}
  />

  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Features', href: '#features' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Blog', href: '/blog' },
      ]}
      actions={[{ text: 'Download', href: '#download' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- ═══════════ Hero：H1 含核心词 + 首段含核心词 + 下载 ═══════════ -->
  <Hero2
    tagline={app.name}
    image={{
      src: meowTalkieBanner,
      alt: app.banner.alt,
      layout: 'aspectRatio',
      aspectRatio: '1024:502',
      style: 'cursor: pointer;',
      'data-aw-banner-open': '1',
      'data-aw-open-apple': app.appStoreDownloadLink,
      'data-aw-open-google': app.googlePlayDownloadLink,
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">MeowTalkie</span>: Talk to Your Cat
    </Fragment>

    <Fragment slot="subtitle">Cat sounds and a playful cat communicator</Fragment>

    <Fragment slot="content">
      Tired of the same old cat toys? MeowTalkie lets you call, train or just chat with your cat using funny sounds and
      meows. The ultimate cat communicator app for fun and bonding.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download MeowTalkie on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get MeowTalkie on Google Play" width={200} />
      </Button>
    </div>
  </Hero2>

  <!-- ═══════════ Features：功能名自然含功能词 ═══════════ -->
  <Features3
    id="features"
    tagline="Features"
    title="Experience the Difference"
    subtitle="Simple, effective cat communication with a clean and intuitive interface."
    columns={2}
    items={[
      {
        title: 'Real Cat Commands',
        description:
          'Send clear signals like “Come Here!”, “Food Time!” or “Leave It!” to aid in positive cat training.',
        icon: 'tabler:command',
      },
      {
        title: 'Funny Sound Library',
        description: 'A large collection of meows, purrs and trills for endless cat entertainment.',
        icon: 'tabler:music',
      },
      {
        title: 'Zero Distractions',
        description: 'A completely ad-free experience. Focus on the fun, not the ads.',
        icon: 'tabler:ad-off',
      },
      {
        title: 'Strengthen Your Bond',
        description:
          'Create fun, interactive moments that bring you closer to your pet — a brand-new type of digital cat toy.',
        icon: 'tabler:heart',
      },
      {
        title: 'Perfect for Playtime & Training',
        description:
          'Initiate playtime, call your cat from across the house, or just have a silly conversation with meow sounds.',
        icon: 'tabler:cat',
      },
      {
        title: 'Cat Sounds Soundboard',
        description:
          'A handy soundboard of cat meow sounds and purrs, ready whenever you want to get your cat’s attention.',
        icon: 'tabler:volume',
      },
    ]}
  />

  <!-- ═══════════ 产品介绍：场景 + 内容 + 政策（恢复自原始内容，已清理堆砌）═══════════ -->
  <Content
    title="Perfect For"
    items={[
      {
        title: 'Playtime, training, or just having a silly chat.',
        description:
          'Use our funny sound library to initiate playtime, train your cat, or just have a fun conversation.',
        icon: 'tabler:cat',
      },
      {
        title: 'Calling your cat from across the house.',
        description: "Send a clear cat call to get your cat's attention from another room.",
        icon: 'tabler:bell',
      },
      {
        title: 'Finally winning that staring contest!',
        description: 'Use our funny sounds to make your cat tilt their head in curiosity and break the stare.',
        icon: 'tabler:eye',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80',
      alt: 'MeowTalkie Perfect For Image',
    }}
  />

  <Content
    title="Translator & Soundboard"
    items={[
      {
        title: 'A Playful Cat Language Experience',
        description:
          'MeowTalkie is a playful way to talk to your cat — a fun cat communicator with meow sounds, purrs and trills that send clear signals and keep you guessing what they mean.',
        icon: 'tabler:language',
      },
      {
        title: 'Soundboard for Cats',
        description:
          'A cat sounds soundboard with meows, purring and calming sounds — ready whenever you want to get your cat’s attention or start playtime.',
        icon: 'tabler:music',
      },
      {
        title: 'Training & Understanding',
        description:
          'Use consistent cat call patterns and positive reinforcement to train your cat. Over time you will read their reactions better — how they respond to your voice, sounds and routines.',
        icon: 'tabler:heart',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'MeowTalkie Translator & Soundboard',
    }}
  />

  <Content
    title="Unlock the Full Meow-niverse"
    isAfterContent
    items={[
      {
        title: 'Premium Sound Packs',
        description:
          'In-app purchase users unlock exclusive and hilarious premium sound packs, perfect for every feline personality.',
        icon: 'tabler:star',
      },
      {
        title: 'Pricing',
        description:
          'Multiple in-app purchase themes range from $0.99 to $5.99, subject to the real-time pricing of the app.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Payment',
        description: 'After the user purchases and makes the payment, it will be credited to the iTunes account.',
        icon: 'tabler:credit-card',
      },
      {
        title: 'Privacy Policy',
        description:
          '<a class="underline" href="https://z8o7hs56u3.feishu.cn/docx/SumadBIp0oDwnAxGJBwcZ6ASn6f" target="_blank" rel="noopener">View our Privacy Policy</a>.',
        icon: 'tabler:shield',
      },
      {
        title: 'Support',
        description: 'Questions or ideas? Email winkiwiki@QQ.com. We would love to hear from you.',
        icon: 'tabler:mail',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521517407911-565264e7d82d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2069&q=80',
      alt: 'MeowTalkie Premium Sound Packs',
    }}
  />

  <!-- ═══════════ FAQ：真实问题（也是 FAQPage schema）═══════════ -->
  <FAQs id="faq" title="Frequently Asked Questions" items={faqItems} />

  <!-- ═══════════ CTA：最终下载 ═══════════ -->
  <CallToAction
    id="download"
    title="Download MeowTalkie and start a new conversation with your cat."
    subtitle="Free to download and use. Turn meows into meaningful conversations."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={app.appStoreDownloadLink}>
        <Image src="~/assets/images/app-store.png" alt="Download MeowTalkie on the App Store" width={200} />
      </Button>

      <Button variant="link" href={app.googlePlayDownloadLink}>
        <Image src="~/assets/images/google-play.png" alt="Get MeowTalkie on Google Play" width={200} />
      </Button>
    </div>
  </CallToAction>
</Layout>
