---
/**
 * App 合集下载页 — /allApps/
 * 目标：承接首页 Hero 的高点击流量，集中提供九款 Winki App 的下载入口。
 * SEO：唯一 H1、canonical、OG 图、ItemList + SoftwareApplication JSON-LD、产品页内链。
 */
import Layout from '~/layouts/PageLayout.astro';
import AppDownload from '~/components/widgets/AppDownload.astro';
import { Icon } from 'astro-icon/components';
import { getCanonical, getPermalink } from '~/utils/permalinks';

// App 图标（本地资源，避免构建期远程图片超时）
import logoAesthetic from '~/assets/images/post/aesthetic-calculator/logo-512.png';
import logoChronicle from '~/assets/images/post/chronicle/chronicle_logo.png';
import logoDeliseek from '~/assets/images/post/deliseek/deliseek_logo.png';
import logoFlipTimer from '~/assets/images/post/flip-timer/flip-timer-logo-512.png';
import logoFocusOne from '~/assets/images/post/focus-one/focus_one_logo.png';
import logoMeowTalkie from '~/assets/images/post/meow-talkie/logo.png';
import logoPhotoSwipe from '~/assets/images/post/photo-swipe-cleaner/photo-swipe-cleaner-logo-512.png';
import logoVocalTrans from '~/assets/images/travelappicon/vocaltrans_logo.png';
import logoAiTrans from '~/assets/images/aitrans_logo.png';

const url = String(getCanonical(Astro.url.pathname));

const catalog = [
  {
    id: 'chronicle',
    name: 'Chronicle',
    description: 'A calendar-based journal for notes, tasks and plans.',
    icon: logoChronicle,
    category: 'ProductivityApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/chronicle-journal-calendar/id6756258484',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.chronicle.chronicle',
  },
  {
    id: 'meowtalkie',
    name: 'MeowTalkie',
    description: 'A cat soundboard for playful interaction.',
    icon: logoMeowTalkie,
    category: 'EntertainmentApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/meowtalkie-talk-to-your-cat/id6752669946',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.meow_talkie',
  },
  {
    id: 'aitrans',
    name: 'AiTrans',
    description: 'Offline Chinese–English voice translation.',
    icon: logoAiTrans,
    category: 'TravelApplication',
    platforms: ['Android'],
    appStoreLink: '',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.aitrans',
  },
  {
    id: 'aesthetic-calculator',
    name: 'Aesthetic Calculator',
    description: 'Cute themes, skins and colors. Ad-free.',
    icon: logoAesthetic,
    category: 'UtilitiesApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/aesthetic-calculator/id6748415125',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.aesthetic_calculator',
  },
  {
    id: 'deliseek',
    name: 'DeliSeek',
    description: 'Find local food and translate menus in China.',
    icon: logoDeliseek,
    category: 'TravelApplication',
    platforms: ['Android'],
    appStoreLink: '',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.deliseek',
  },
  {
    id: 'focus-one',
    name: 'Focus One',
    description: 'A visual focus timer for one task at a time.',
    icon: logoFocusOne,
    category: 'ProductivityApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/focus-one-adhd-focus-timer/id6748545171',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.focus_one',
  },
  {
    id: 'flip-timer',
    name: 'Flip Timer',
    description: 'Start a countdown by flipping your phone.',
    icon: logoFlipTimer,
    category: 'UtilitiesApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/flip-timer-gym-study-work/id6752959227',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.flip_timer',
  },
  {
    id: 'photo-swipe-cleaner',
    name: 'Photo Swipe Cleaner',
    description: 'Keep or delete photos with simple swipes.',
    icon: logoPhotoSwipe,
    category: 'UtilitiesApplication',
    platforms: ['iOS', 'Android'],
    appStoreLink: 'https://apps.apple.com/us/app/photo-swipe-cleaner-clean-up/id6752958088',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.photo_swipe_cleaner',
  },
  {
    id: 'vocaltrans',
    name: 'VocalTrans',
    description: 'Offline voice translation for travel conversations.',
    icon: logoVocalTrans,
    category: 'TravelApplication',
    platforms: ['Android'],
    appStoreLink: '',
    googlePlayLink: 'https://play.google.com/store/apps/details?id=wiki.winki.vocaltrans',
  },
];

const groups = [
  {
    title: 'Focus and time',
    description: 'Timers that keep one task in view and remove the guesswork from a session.',
    icon: 'tabler:target',
    apps: ['focus-one', 'flip-timer'],
  },
  {
    title: 'Plan, remember, tidy up',
    description:
      'A private timeline for notes and tasks, a calculator that looks good, and a faster way to clear photos.',
    icon: 'tabler:calendar',
    apps: ['chronicle', 'aesthetic-calculator', 'photo-swipe-cleaner'],
  },
  {
    title: 'Travel and language',
    description: 'Offline translation and local food discovery for trips where the connection is unreliable.',
    icon: 'tabler:world',
    apps: ['vocaltrans', 'aitrans', 'deliseek'],
  },
  {
    title: 'Everyday fun',
    description: 'A soundboard for playing and interacting with your cat.',
    icon: 'tabler:paw',
    apps: ['meowtalkie'],
  },
];

const metadata = {
  title: 'Winki Apps Download: 9 Apps for iOS and Android',
  description:
    'Download every Winki app in one place: Chronicle, MeowTalkie, AiTrans, Aesthetic Calculator, DeliSeek, Focus One, Flip Timer, Photo Swipe Cleaner and VocalTrans. Direct App Store and Google Play links.',
  canonical: url,
  openGraph: {
    type: 'website',
    url,
    images: [
      {
        url: '~/assets/images/hero-image.png',
        width: 1600,
        height: 940,
        alt: 'Winki apps collection — download links for iOS and Android',
      },
    ],
  },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Winki apps',
  description: 'The complete list of Winki apps with App Store and Google Play download links.',
  numberOfItems: catalog.length,
  itemListElement: catalog.map((app, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: app.name,
      description: app.description,
      url: String(new URL(getPermalink(`/homes/${app.id}`), Astro.site)),
      applicationCategory: app.category,
      operatingSystem: app.platforms.join(', '),
      installUrl: [app.appStoreLink, app.googlePlayLink].filter(Boolean),
    },
  })),
};
---

<Layout metadata={metadata}>
  {(<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}

  <div class="bg-page text-default">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 h-72 w-[44rem] -translate-x-1/2 rounded-full bg-primary/20 blur-3xl">
        </div>
        <div class="absolute -bottom-24 right-0 h-56 w-56 rounded-full bg-accent/10 blur-3xl"></div>
      </div>

      <div class="relative max-w-[1024px] mx-auto px-4 pt-16 pb-10 md:pt-24 md:pb-12">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Winki App Directory</p>
        <h1 class="mt-4 max-w-3xl text-4xl md:text-5xl font-bold leading-tight tracking-tight font-heading">
          Download all Winki apps
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted">
          Tap the App Store or Google Play icon on any card to open its download page.
        </p>
      </div>
    </section>

    <!-- Download grid -->
    <section id="download" class="max-w-[1024px] mx-auto px-4 pt-5 pb-14 md:pt-10 md:pb-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          catalog.map((app) => (
            <div class="flex flex-col gap-3">
              <AppDownload
                name={app.name}
                description={app.description}
                icon={app.icon}
                appStoreLink={app.appStoreLink}
                googlePlayLink={app.googlePlayLink}
              />
              <div class="flex items-center justify-center px-1 text-xs">
                <a
                  href={getPermalink(`/homes/${app.id}`)}
                  class="text-primary hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
                >
                  Explore {app.name}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-xs text-muted">
        Availability and device requirements can vary by country and operating system. Check the store listing before
        installing.
      </p>
    </section>

    <!-- Which app to start with -->
    <section class="bg-gray-50 dark:bg-slate-950/40">
      <div class="max-w-[1024px] mx-auto px-4 py-14 md:py-20">
        <h2 class="text-2xl md:text-3xl font-bold font-heading">Not sure where to start?</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Start from the job you want to finish, then open the product page for the details.
        </p>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {
            groups.map((group) => (
              <div class="rounded-xl border border-gray-200 bg-white p-6 dark:border-white/10 dark:bg-slate-900/60">
                <Icon name={group.icon} class="w-6 h-6 text-primary" />
                <h3 class="mt-4 font-bold">{group.title}</h3>
                <p class="mt-2 text-sm text-muted">{group.description}</p>
                <ul class="mt-4 space-y-2 text-sm">
                  {group.apps.map((id) => {
                    const app = catalog.find((item) => item.id === id);
                    return (
                      app && (
                        <li>
                          <a href={getPermalink(`/homes/${app.id}`)} class="text-primary hover:underline">
                            {app.name}
                          </a>
                        </li>
                      )
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Support / more -->
    <section>
      <div class="max-w-[1024px] mx-auto px-4 py-14">
        <h2 class="text-2xl font-bold font-heading">Questions before installing?</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Read the <a href={getPermalink('/blog')} class="text-primary hover:underline">Winki blog</a> for developer stories
          and release notes, <a href={getPermalink('/about')} class="text-primary hover:underline"
            >learn how the apps are made</a
          >, or <a href={getPermalink('/contact')} class="text-primary hover:underline">contact support</a> with the app
          name, device, operating system and app version.
        </p>
      </div>
    </section>
  </div>
</Layout>
