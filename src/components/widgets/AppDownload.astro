---
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';

import { apps } from '~/data/apps';

interface Props {
  name: string;
  description?: string;
  icon: ImageMetadata | string;
  appStoreLink?: string;
  googlePlayLink?: string;
  appStoreQr?: ImageMetadata | string;
  googlePlayQr?: ImageMetadata | string;
}

const { name, description, icon, appStoreQr, googlePlayQr, appStoreLink = '', googlePlayLink = '' } = Astro.props;
// 产品页取 apps.ts 的规范 id；第三方卡片回落到 slug
const appId = apps.find((app) => app.name === name)?.id ?? name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const id = `app-${Math.random().toString(36).substring(2, 11)}`;

const iconSrc = typeof icon === 'string' ? icon : icon.src;
const appStoreQrSrc = appStoreQr ? (typeof appStoreQr === 'string' ? appStoreQr : appStoreQr.src) : null;
const googlePlayQrSrc = googlePlayQr ? (typeof googlePlayQr === 'string' ? googlePlayQr : googlePlayQr.src) : null;

// 是否传入了应用商店下载链接（有链接 → 点击跳转；无链接 → 保持原扫码行为）
const appStoreLinkHref = appStoreLink.startsWith('http') ? appStoreLink : undefined;
const googlePlayLinkHref = googlePlayLink.startsWith('http') ? googlePlayLink : undefined;

// 只有存在下载链接或二维码时才显示对应商店图标，避免出现无入口的图标
const showAppStore = Boolean(appStoreLinkHref || appStoreQrSrc);
const showGooglePlay = Boolean(googlePlayLinkHref || googlePlayQrSrc);
---

<div
  class="not-prose bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-100 dark:border-slate-700 shadow-sm flex flex-col items-center text-center app-card"
  id={id}
  data-app-id={appId}
>
  <div
    class="w-24 h-24 bg-slate-50 dark:bg-slate-900 rounded-lg flex items-center justify-center mb-4 relative overflow-hidden group"
  >
    <!-- Main Icon -->
    <img
      src={iconSrc}
      alt={name}
      width="96"
      height="96"
      loading="lazy"
      class="w-full h-full object-contain p-2 app-icon transition-opacity duration-300 absolute inset-0 z-10"
    />

    <!-- App Store QR -->
    {
      appStoreQrSrc && (
        <img
          src={appStoreQrSrc}
          alt={`${name} App Store QR`}
          data-link={appStoreLinkHref}
          width="96"
          height="96"
          loading="lazy"
          class="w-full h-full object-contain p-1 absolute inset-0 opacity-0 transition-opacity duration-300 z-20 qr-ios bg-white dark:bg-slate-800"
        />
      )
    }

    <!-- Google Play QR -->
    {
      googlePlayQrSrc && (
        <img
          src={googlePlayQrSrc}
          alt={`${name} Google Play QR`}
          data-link={googlePlayLinkHref}
          width="96"
          height="96"
          loading="lazy"
          class="w-full h-full object-contain p-1 absolute inset-0 opacity-0 transition-opacity duration-300 z-20 qr-android bg-white dark:bg-slate-800"
        />
      )
    }

    <!-- Camera Scan Hint (optional, shows on hover if needed, or just static below) -->
  </div>

  <h3 class="text-[10px] text-slate-400">{name}</h3>
  {description && <p class="text-sm font-bold mt-1 mb-3">{description}</p>}
  <p class="text-[9px] text-slate-400 mb-2 flex items-center gap-1 justify-center">
    <Icon name="tabler:camera" class="w-3 h-3" /> Scan to Download
  </p>

  <div class="flex items-center justify-center gap-6">
    {
      showAppStore &&
        (appStoreLinkHref ? (
          <a
            href={appStoreLinkHref}
            target="_blank"
            rel="noopener noreferrer"
            class="platform-btn text-primary hover:text-primary/80 transition-colors focus:outline-none"
            data-target="ios"
            data-download-platform="ios"
            data-app-id={appId}
            aria-label="App Store"
          >
            <Icon name="tabler:brand-apple" class="w-6 h-6" />
          </a>
        ) : (
          <button
            class="platform-btn text-primary hover:text-primary/80 transition-colors focus:outline-none"
            data-target="ios"
            aria-label="App Store"
          >
            <Icon name="tabler:brand-apple" class="w-6 h-6" />
          </button>
        ))
    }
    {
      showGooglePlay &&
        (googlePlayLinkHref ? (
          <a
            href={googlePlayLinkHref}
            target="_blank"
            rel="noopener noreferrer"
            class="platform-btn text-primary hover:text-primary/80 transition-colors focus:outline-none"
            data-target="android"
            data-download-platform="android"
            data-app-id={appId}
            aria-label="Google Play"
          >
            <Icon name="tabler:brand-google-play" class="w-5 h-5" />
          </a>
        ) : (
          <button
            class="platform-btn text-primary hover:text-primary/80 transition-colors focus:outline-none"
            data-target="android"
            aria-label="Google Play"
          >
            <Icon name="tabler:brand-google-play" class="w-5 h-5" />
          </button>
        ))
    }
  </div>
</div>

<script>
  function setupAppCards() {
    const cards = document.querySelectorAll('.app-card');

    cards.forEach((card) => {
      const iosBtn = card.querySelector('[data-target="ios"]');
      const androidBtn = card.querySelector('[data-target="android"]');
      const icon = card.querySelector('.app-icon');
      const qrIos = card.querySelector('.qr-ios');
      const qrAndroid = card.querySelector('.qr-android');

      // 二维码点击：有下载链接 → 跳转对应商店
      const openLink = (el, e) => {
        const link = el?.getAttribute('data-link');
        if (link) {
          e.stopPropagation();
          e.preventDefault();
          window.open(link, '_blank', 'noopener');
          return true;
        }
        return false;
      };

      const showQr = (type) => {
        // Reset all first
        if (icon) icon.classList.remove('opacity-0');
        if (qrIos) qrIos.classList.add('opacity-0');
        if (qrAndroid) qrAndroid.classList.add('opacity-0');

        // Show specific QR
        if (type === 'ios' && qrIos) {
          if (icon) icon.classList.add('opacity-0');
          qrIos.classList.remove('opacity-0');
        } else if (type === 'android' && qrAndroid) {
          if (icon) icon.classList.add('opacity-0');
          qrAndroid.classList.remove('opacity-0');
        }
      };

      const bind = (el, type) => {
        if (!el) return;
        el.addEventListener('mouseenter', () => showQr(type));
        // 有下载链接时是原生 <a>，点击直接跳转；无链接时才用按钮切换二维码
        if (el.tagName === 'BUTTON') {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            showQr(type);
          });
        }
      };

      bind(iosBtn, 'ios');
      bind(androidBtn, 'android');

      qrIos?.addEventListener('click', (e) => openLink(qrIos, e));
      qrAndroid?.addEventListener('click', (e) => openLink(qrAndroid, e));

      // Reset when leaving the card
      card.addEventListener('mouseleave', () => showQr('none'));
    });
  }

  // Run on load
  setupAppCards();

  // Run on view transitions if enabled
  document.addEventListener('astro:page-load', setupAppCards);
</script>
