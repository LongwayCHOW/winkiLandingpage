---
import type { ItemGrid as Props } from '~/types';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

const { items = [], columns, defaultIcon = '', classes = {}, linkItems = false } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
  action: actionClass = '',
} = classes;
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `grid mx-auto gap-8 md:gap-y-12 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, classes: itemClasses = {} }) => {
        // 图标两种形态：tabler 名称走 astro-icon；对象（ImageMetadata）或 URL 字符串走真实 App 图标
        const iconSrc =
          icon && typeof icon === 'object'
            ? icon.src
            : typeof icon === 'string' && /^(https?:\/\/|\/)/.test(icon)
              ? icon
              : null;
        const iconName = typeof icon === 'string' && !iconSrc ? icon : '';
        const isLinked = linkItems && Boolean(callToAction?.href);
        const Panel = isLinked ? 'a' : 'div';
        const panelLinkProps =
          isLinked && callToAction
            ? {
                href: callToAction.href,
                ...(callToAction.target ? { target: callToAction.target, rel: 'noopener noreferrer' } : {}),
              }
            : {};

        return (
          <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <Panel
              {...panelLinkProps}
              class={twMerge(
                'flex flex-row max-w-md',
                panelClass,
                itemClasses?.panel,
                isLinked &&
                  'group rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2'
              )}
            >
              <div class="flex justify-center">
                {(iconSrc || iconName || defaultIcon) &&
                  (iconSrc ? (
                    <img
                      src={iconSrc}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      class={twMerge(
                        'w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2 object-contain',
                        defaultIconClass,
                        itemClasses?.icon,
                        'p-0 md:p-0'
                      )}
                    />
                  ) : (
                    <Icon
                      name={iconName || defaultIcon}
                      class={twMerge('w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2', defaultIconClass, itemClasses?.icon)}
                    />
                  ))}
              </div>
              <div class="mt-0.5">
                {title && <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</h3>}
                {description && (
                  <p
                    class={twMerge(`${title ? 'mt-3' : ''} text-muted`, descriptionClass, itemClasses?.description)}
                    set:html={description}
                  />
                )}
                {callToAction && (
                  <div class={twMerge(`${title || description ? 'mt-3' : ''}`, actionClass, itemClasses?.actionClass)}>
                    {isLinked ? (
                      <span class="group-hover:text-primary">{callToAction.text}</span>
                    ) : (
                      <Button variant="link" {...callToAction} />
                    )}
                  </div>
                )}
              </div>
            </Panel>
          </div>
        );
      })}
    </div>
  )
}
