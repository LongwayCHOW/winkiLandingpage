---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id;
---

{id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />}
<script is:inline define:vars={{ id }}>
  // Initialize once; ConversionEvents sends first-load and ClientRouter page views.
  if (id && !window.winkiAnalyticsInitialized) {
    window.winkiAnalyticsInitialized = true;
    window.dataLayer = window.dataLayer || [];
    // Must push `arguments` (not a rest array): gtag.js only treats Arguments
    // objects as gtag commands; plain arrays are silently ignored.
    // eslint-disable-next-line prefer-rest-params -- gtag.js requires Arguments objects
    window.gtag = function () {
      window.dataLayer.push(arguments); // eslint-disable-line prefer-rest-params
    };
    window.gtag('js', new Date());
    window.gtag('config', id, { send_page_view: false });
  }
</script>
