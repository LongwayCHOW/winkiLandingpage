---
/**
 * AppSchema — 为 app 落地页注入结构化数据（JSON-LD）
 *
 * 输出两种 schema：
 *   1. SoftwareApplication：让搜索引擎理解这是一个 app（名称、平台、下载链接、价格、评分）
 *   2. FAQPage：表达可见 FAQ；普通 App 网站不应期待 FAQ 富结果
 *
 * 用法（在落地页 <Layout> 内任意位置引用一次）：
 *   <AppSchema
 *     name="Chronicle: Journal Calendar"
 *     description="An all-in-one planner, diary, to-do list and habit tracker on one timeline."
 *     url={getPermalink('/homes/chronicle')}
 *     image="https://winki.win/images/chronicle-banner.png"
 *     operatingSystems={['iOS', 'Android']}
 *     androidAppStoreId="wiki.winki.chronicle.chronicle"
 *     iosAppStoreId="id6756258484"
 *     price="0"
 *     currency="USD"
 *     faqItems={[{ q: 'What is Chronicle?', a: '...' }]}
 *   />
 */
import { isDemoPath } from '~/utils/seo-policy';
import { SITE } from 'astrowind:config';

interface Props {
  name: string;
  description: string;
  url?: string;
  image?: string;
  operatingSystems?: string[];
  iosAppStoreId?: string;
  androidAppStoreId?: string;
  price?: string;
  currency?: string;
  /** 真实评分可选；无真实数据请勿填 */
  ratingValue?: string;
  ratingCount?: number;
  faqItems?: Array<{ q: string; a: string }>;
}

const {
  name,
  description,
  url = '',
  image = '',
  operatingSystems = [],
  iosAppStoreId,
  androidAppStoreId,
  price,
  currency = 'USD',
  ratingValue,
  ratingCount,
  faqItems = [],
} = Astro.props;

/* 将相对路径转成绝对 URL（Google schema 要求绝对地址） */
const toAbsolute = (path: string): string => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://')) return path;
  try {
    return String(new URL(path, SITE.site));
  } catch {
    return path;
  }
};

const absoluteUrl = toAbsolute(url);
const absoluteImage = toAbsolute(image);
const installUrls = [
  ...(iosAppStoreId
    ? [`https://apps.apple.com/app/${iosAppStoreId.startsWith('id') ? iosAppStoreId : `id${iosAppStoreId}`}`]
    : []),
  ...(androidAppStoreId
    ? [`https://play.google.com/store/apps/details?id=${encodeURIComponent(androidAppStoreId)}`]
    : []),
];
const categories: Record<string, string> = {
  chronicle: 'ProductivityApplication',
  'focus-one': 'ProductivityApplication',
  'flip-timer': 'UtilitiesApplication',
  'aesthetic-calculator': 'UtilitiesApplication',
  'photo-swipe-cleaner': 'UtilitiesApplication',
  meowtalkie: 'EntertainmentApplication',
  deliseek: 'TravelApplication',
  vocaltrans: 'TravelApplication',
  aitrans: 'TravelApplication',
};

const offers: Record<string, unknown> = {
  '@type': 'Offer',
  price,
  priceCurrency: currency,
};

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name,
      description,
      url: absoluteUrl,
      image: absoluteImage,
      applicationCategory: categories[Astro.url.pathname.split('/')[2]] || 'UtilitiesApplication',
      operatingSystem: operatingSystems.join(', '),
      ...(price !== undefined ? { offers } : {}),
      installUrl: installUrls,
      identifier: [
        ...(iosAppStoreId
          ? [{ '@type': 'PropertyValue', propertyID: 'Apple App Store ID', value: iosAppStoreId }]
          : []),
        ...(androidAppStoreId
          ? [{ '@type': 'PropertyValue', propertyID: 'Google Play package', value: androidAppStoreId }]
          : []),
      ],
      ...(ratingValue && ratingCount
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue,
              ratingCount,
            },
          }
        : {}),
    },
  ],
};

if (faqItems.length) {
  (schema['@graph'] as Record<string, unknown>[]).push({
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}
---

{
  !isDemoPath(Astro.url.pathname) && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  )
}
