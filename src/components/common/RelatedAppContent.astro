---
import { findAppByPath } from '~/data/apps';
import { findPostsBySlugs } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const app = findAppByPath(Astro.url.pathname);
const posts = app ? await findPostsBySlugs([app.article]) : [];
---

{
  app && (
    <section class="max-w-3xl mx-auto px-6 py-12 border-t border-gray-200 dark:border-slate-700">
      <h2 class="text-2xl font-bold mb-4">Learn more about {app.name}</h2>
      <p class="text-muted mb-4">
        {posts.length
          ? 'Read the developer’s account of the choices behind this app.'
          : 'Plan the practical details of your next trip to China.'}
      </p>
      <ul class="space-y-3">
        {posts.length ? (
          posts.map((post) => (
            <li>
              <a class="text-primary underline" href={getPermalink(post.permalink, 'post')}>
                {post.title}
              </a>
            </li>
          ))
        ) : (
          <li>
            <a class="text-primary underline" href={getPermalink('/travel-china')}>
              China travel apps and planning checklist
            </a>
          </li>
        )}
        {'category' in app && (
          <li>
            <a class="text-primary underline" href={getPermalink(app.category, 'category')}>
              All {app.name} developer notes
            </a>
          </li>
        )}
      </ul>
    </section>
  )
}
